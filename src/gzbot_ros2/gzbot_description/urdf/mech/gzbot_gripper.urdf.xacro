<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="gzbot_gripper">
        <!-- 夹爪底座 -->
        <link name="gripper_base_link">
            <xacro:box_inertial m="0.1" x="0.20" y="0.06" z="0.02" />
            <visual>
                <geometry>
                    <box size="0.20 0.06 0.02" />
                </geometry>
                <origin xyz="0 0 0.01" rpy="0 0 0" />
                <material name="dark_green">
                    <color rgba="0 0.4 0 1" />
                </material>
            </visual>

            <collision>
                <geometry>
                    <box size="0.20 0.06 0.02" />
                </geometry>
                <origin xyz="0 0 0.01" rpy="0 0 0" />
            </collision>
        </link>

        <!-- 左夹爪手指 -->
        <link name="gripper_left_finger_link">
            <xacro:box_inertial m="0.02" x="0.02" y="0.06" z="0.08" />
            <visual>
                <geometry>
                    <box size="0.02 0.06 0.08" />
                </geometry>
                <origin xyz="0 0 0.04" rpy="0 0 0" />
                <material name="light_green">
                    <color rgba="0 0.6 0 1" />
                </material>
            </visual>

            <collision>
                <geometry>
                    <box size="0.02 0.06 0.08" />
                </geometry>
                <origin xyz="0 0 0.04" rpy="0 0 0" />
            </collision>
        </link>

        <!-- 右夹爪手指 -->
        <link name="gripper_right_finger_link">
            <xacro:box_inertial m="0.02" x="0.02" y="0.06" z="0.08" />
            <visual>
                <geometry>
                    <box size="0.02 0.06 0.08" />
                </geometry>
                <origin xyz="0 0 0.04" rpy="0 0 0" />
                <material name="light_green">
                    <color rgba="0 0.6 0 1" />
                </material>
            </visual>

            <collision>
                <geometry>
                    <box size="0.02 0.06 0.08" />
                </geometry>
                <origin xyz="0 0 0.04" rpy="0 0 0" />
            </collision>
        </link>

        <!-- 左手指连接到底座（axis 朝外、零点=张开，负值=闭合，与 mycobot 习惯一致） -->
        <joint name="gripper_left_finger_joint" type="prismatic">
            <parent link="gripper_base_link" />
            <child link="gripper_left_finger_link" />
            <origin xyz="-0.07 0 0.02" rpy="0 0 0" />
            <axis xyz="-1 0 0" />
            <limit effort="1000.0" velocity="1.0" lower="-0.06" upper="0.0" />
        </joint>

        <!-- 右手指连接到底座（mimic 标签：gz 物理引擎会忽略，物理联动由 ros2_control 的 mimic param 实现；
             此标签供 robot_state_publisher 显示右手指、MoveIt 解析用） -->
        <joint name="gripper_right_finger_joint" type="prismatic">
            <parent link="gripper_base_link" />
            <child link="gripper_right_finger_link" />
            <origin xyz="0.07 0 0.02" rpy="0 0 0" />
            <axis xyz="1 0 0" />
            <mimic joint="gripper_left_finger_joint" multiplier="1.0" offset="0.0" />
            <limit effort="1000.0" velocity="1.0" lower="-0.06" upper="0.0" />
        </joint>
    </xacro:macro>

</robot>
