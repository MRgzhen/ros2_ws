<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ============ 惯性张量宏：按几何形状自动计算 ============
         gz 物理引擎要求活动关节连接的 link 必须有有效质量/惯性，
         零惯性实体会被拒绝创建（这是之前机器人进不去 gz 的根因）。
         公式来源：标准刚体惯性张量，惯性原点取几何中心。 -->

    <!-- 长方体：m 质量(kg)，x y z 三边长(m) -->
    <xacro:macro name="box_inertial" params="m x y z">
        <inertial>
            <mass value="${m}" />
            <inertia
                ixx="${m * (y*y + z*z) / 12.0}" ixy="0" ixz="0"
                iyy="${m * (x*x + z*z) / 12.0}" iyz="0"
                izz="${m * (x*x + y*y) / 12.0}" />
        </inertial>
    </xacro:macro>

    <!-- 圆柱体：m 质量(kg)，r 半径(m)，l 长度(m)，轴沿 z -->
    <xacro:macro name="cylinder_inertial" params="m r l">
        <inertial>
            <mass value="${m}" />
            <inertia
                ixx="${m * (3*r*r + l*l) / 12.0}" ixy="0" ixz="0"
                iyy="${m * (3*r*r + l*l) / 12.0}" iyz="0"
                izz="${m * r*r / 2.0}" />
        </inertial>
    </xacro:macro>

    <!-- 极小占位惯性：给无几何的虚拟 link（如 tool_link）兜底 -->
    <xacro:macro name="dummy_inertial">
        <inertial>
            <mass value="0.001" />
            <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
        </inertial>
    </xacro:macro>

</robot>
