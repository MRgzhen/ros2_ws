<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_gazebo" default="false" />

  <xacro:include filename="$(find gzbot_description)/urdf/mech/common_properties.urdf.xacro" />
  <xacro:include filename="$(find gzbot_description)/urdf/common/inertial_macros.urdf.xacro" />

  <xacro:include filename="$(find gzbot_description)/urdf/mech/gzbot_arm.urdf.xacro" />
  <xacro:gzbot_arm />

  <xacro:include filename="$(find gzbot_description)/urdf/mech/gzbot_gripper.urdf.xacro" />
  <xacro:gzbot_gripper />

  <xacro:include filename="$(find gzbot_description)/urdf/control/gzbot_ros2_control.urdf.xacro" />
  <xacro:gzbot_ros2_control use_gazebo="$(arg use_gazebo)" />

  <xacro:include filename="$(find gzbot_description)/urdf/control/gzbot_sim_ros2_control.urdf.xacro" />
  <xacro:gzbot_sim_ros2_control use_gazebo="$(arg use_gazebo)" />

  <joint name="gripper_base_joint" type="fixed">
    <parent link="tool_link" />
    <child link="gripper_base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

</robot>