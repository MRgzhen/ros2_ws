<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gzbot_gazebo</name>
  <version>0.0.0</version>
  <description>Gazebo (gz-sim) simulation support for the gzbot robot: worlds, models and launch files</description>
  <maintainer email="1175533636@qq.com">gz</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ros2_control 控制相关（Humble 无 parallel_gripper_controller，夹爪用 GripperActionController，mimic 关节由 gz-sim 物理引擎处理） -->
  <depend>controller_manager</depend>
  <depend>gripper_controllers</depend>
  <depend>gz_ros2_control</depend>
  <depend>ros2_control</depend>
  <depend>ros2_controllers</depend>
  <depend>ros_gz_sim</depend>
  <depend>xacro</depend>

  <!-- 运行时依赖：launch 中加载机器人模型与桥接话题/图像 -->
  <exec_depend>gzbot_description</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
