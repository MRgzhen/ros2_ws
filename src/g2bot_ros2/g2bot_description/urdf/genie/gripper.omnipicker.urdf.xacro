<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- main xacro -->
  <xacro:macro
    name="gripper_l"
    params="tf_prefix parent_link xyz_offset rpy_offset visual_type collision_type mesh_dir app">

    <!-- Camera Link -->
    <link
      name="gripper_l_camera_link">
      <inertial>
        <origin
          xyz="0.012045 0.074409 0.04124"
          rpy="0 0 0" />
        <mass
          value="0.22805" />
        <inertia
          ixx="0.00033371"
          ixy="3.224E-05"
          ixz="1.4808E-05"
          iyy="0.00016245"
          iyz="0.00011846"
          izz="0.00033421" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="${mesh_dir}/gripper/omnipicker/camera_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.86667 0.86667 0.8902 1" />
        </material>
      </visual>
      <xacro:if value="${collision_type == 'fine' or collision_type == 'swept_hull'}">
        <collision name="gripper_l_camera_link_convex_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/omnipicker/convex/camera_link.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="gripper_l_camera_link_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint
      name="idx30_gripper_l_camera_joint"
      type="fixed">
      <origin
        xyz="0 0 0.0"
        rpy="${rpy_offset}" />
      <parent
        link="${parent_link}" />
      <child
        link="gripper_l_camera_link" />
      <axis
        xyz="0 0 0" />
    </joint>

    <!-- Gripper Base Connector -->
    <joint
      name="idx51_ee_l_joint"
      type="fixed">
      <origin
        xyz="${xyz_offset}"
        rpy="${rpy_offset}" />
      <parent
        link="${parent_link}" />
      <child
        link="gripper_l_base_link" />
      <axis
        xyz="0 0 0" />
    </joint>
    <!-- Gripper L-->
    <link name="gripper_l_base_link">
      <inertial>
        <origin
          xyz="-0.00013356 1.5301E-05 0.03322"
          rpy="0 0 0" />
        <mass
          value="0.23588" />
        <inertia
          ixx="8.1548E-05"
          ixy="-1.2617E-08"
          ixz="-2.05E-07"
          iyy="5.6921E-05"
          iyz="6.6903E-08"
          izz="7.1611E-05" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_dir}/gripper/omnipicker/base_link.dae" />
        </geometry>
        <!-- <material name="white" /> -->
      </visual>
      <xacro:if value="${collision_type == 'fine'}">
        <collision name="gripper_l_base_link_convex_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/gripper/omnipicker/convex/base_link.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="gripper_l_base_link_convex_0" />
        </collision_checking>
      </xacro:if>
      <xacro:if value="${collision_type == 'swept_hull'}">
        <collision name="gripper_l_base_link_swept_hull_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/gripper/omnipicker/swept_hull/left_gripper.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="gripper_l_base_link_swept_hull_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <link name="gripper_l_inner_link1">
      <inertial>
        <origin
          xyz="0.0094685 0.0068806 6.5437E-05"
          rpy="0 0 0" />
        <mass
          value="0.025428" />
        <inertia
          ixx="1.9574E-06"
          ixy="-4.2911E-07"
          ixz="-3.7111E-11"
          iyy="2.3919E-06"
          iyz="-3.008E-10"
          izz="1.5501E-06" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_dir}/gripper/omnipicker/inner_link1.dae" />
        </geometry>
        <!-- <material name="orange" /> -->
      </visual>
      <xacro:if value="${collision_type == 'fine'}">
        <collision name="gripper_l_inner_link1_convex_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/gripper/omnipicker/convex/inner_link1.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="gripper_l_inner_link1_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint
      name="idx31_gripper_l_inner_joint1"
      type="revolute">
      <origin
        xyz="0 -0.0195 0.0565"
        rpy="${pi-2.9951} -${PI_2} -0.15964" />
      <parent
        link="gripper_l_base_link" />
      <child
        link="gripper_l_inner_link1" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-${radians(45)}"
        upper="0"
        effort="10"
        velocity="10" />
    </joint>
    <link name="gripper_l_inner_link3">
      <inertial>
        <origin
          xyz="0.0088027 -0.007035 1.6424E-05"
          rpy="0 0 0" />
        <mass
          value="0.0040132" />
        <inertia
          ixx="1.0307E-07"
          ixy="5.7851E-08"
          ixz="9.5801E-11"
          iyy="1.1385E-07"
          iyz="-2.81E-11"
          izz="1.7009E-07" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_dir}/gripper/omnipicker/inner_link3.dae" />
        </geometry>
        <!-- <material name="green" /> -->
      </visual>
      <xacro:if value="${collision_type == 'fine'}">
        <collision name="gripper_l_inner_link3_convex_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/gripper/omnipicker/convex/inner_link3.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="gripper_l_inner_link3_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint
      name="idx32_gripper_l_inner_joint3"
      type="revolute">
      <origin
        xyz="0.030852 -0.018551 0"
        rpy="${PI} 0 0" />
      <parent
        link="gripper_l_inner_link1" />
      <child
        link="gripper_l_inner_link3" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-2"
        upper="2"
        effort="10"
        velocity="10" />
      <mimic joint="idx31_gripper_l_inner_joint1" multiplier="0.1" offset="0" />
    </joint>
    <link name="gripper_l_inner_link4">
      <inertial>
        <origin
          xyz="0.012508 -0.0079729 9.4339E-05"
          rpy="0 0 0" />
        <mass
          value="0.018029" />
        <inertia
          ixx="1.1403E-06"
          ixy="5.5159E-07"
          ixz="-4.0096E-13"
          iyy="2.5704E-06"
          iyz="1.0951E-12"
          izz="2.3252E-06" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_dir}/gripper/omnipicker/inner_link4.dae" />
        </geometry>
        <!-- <material name="white" /> -->
      </visual>
      <xacro:if value="${collision_type == 'fine'}">
        <collision name="gripper_l_inner_link4_convex_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/gripper/omnipicker/convex/inner_link4.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="gripper_l_inner_link4_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint
      name="idx33_gripper_l_inner_joint4"
      type="revolute">
      <origin
        xyz="0.018118 -0.01574 0"
        rpy="0 0 0" />
      <parent
        link="gripper_l_inner_link3" />
      <child
        link="gripper_l_inner_link4" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-2"
        upper="2"
        effort="10"
        velocity="10" />
      <mimic joint="idx31_gripper_l_inner_joint1" multiplier="0.25" offset="0" />
    </joint>
    <link name="gripper_l_inner_link2">
      <inertial>
        <origin
          xyz="0.014869 -0.0036066 0.00029307"
          rpy="0 0 0" />
        <mass
          value="0.022591" />
        <inertia
          ixx="4.3916E-06"
          ixy="1.114E-07"
          ixz="-4.9655E-12"
          iyy="4.737E-06"
          iyz="1.7121E-11"
