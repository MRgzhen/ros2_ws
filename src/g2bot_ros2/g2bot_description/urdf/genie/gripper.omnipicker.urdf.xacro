          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_dir}/gripper/omnipicker/inner_link2.dae" />
        </geometry>
        <!-- <material name="blue" /> -->
      </visual>
      <xacro:if value="${collision_type == 'fine'}">
        <collision name="gripper_l_inner_link2_convex_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/gripper/omnipicker/convex/inner_link2.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="gripper_l_inner_link2_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint
      name="idx39_gripper_l_inner_joint0"
      type="revolute">
      <origin
        xyz="0.0 -0.01 0.0"
        rpy="0 0 0" />
      <parent
        link="gripper_l_inner_link4" />
      <child
        link="gripper_l_inner_link2" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-2"
        upper="2"
        effort="10"
        velocity="10" />
      <mimic joint="idx31_gripper_l_inner_joint1" multiplier="-0.7" offset="0" />
    </joint>
    <link name="gripper_l_outer_link1">
      <inertial>
        <origin
          xyz="0.0095051 -0.0068479 6.8268E-05"
          rpy="0 0 0" />
        <mass
          value="0.025428" />
        <inertia
          ixx="1.9565E-06"
          ixy="4.2798E-07"
          ixz="2.3844E-10"
          iyy="2.3928E-06"
          iyz="-1.4454E-10"
          izz="1.5501E-06" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_dir}/gripper/omnipicker/outer_link1.dae" />
        </geometry>
        <!-- <material name="orange" /> -->
      </visual>
      <xacro:if value="${collision_type == 'fine'}">
        <collision name="gripper_l_outer_link1_convex_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/gripper/omnipicker/convex/outer_link1.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="gripper_l_outer_link1_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint
      name="idx41_gripper_l_outer_joint1"
      type="revolute">
      <origin
        xyz="0 0.0195 0.0565"
        rpy="${PI-2.9951} -${PI_2} -0.15964" />
      <parent
        link="gripper_l_base_link" />
      <child
        link="gripper_l_outer_link1" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="0"
        upper="${radians(45)}"
        effort="10"
        velocity="10" />
      <mimic joint="idx31_gripper_l_inner_joint1" multiplier="-1" offset="0" />
    </joint>
    <link name="gripper_l_outer_link3">
      <inertial>
        <origin
          xyz="0.0088027 0.007035 -1.6424E-05"
          rpy="0 0 0" />
        <mass
          value="0.0040132" />
        <inertia
          ixx="1.0307E-07"
          ixy="-5.7851E-08"
          ixz="-9.58E-11"
          iyy="1.1385E-07"
          iyz="-2.81E-11"
          izz="1.7009E-07" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_dir}/gripper/omnipicker/outer_link3.dae" />
        </geometry>
        <!-- <material name="green" /> -->
      </visual>
      <xacro:if value="${collision_type == 'fine'}">
        <collision name="gripper_l_outer_link3_convex_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/gripper/omnipicker/convex/outer_link3.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="gripper_l_outer_link3_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint
      name="idx42_gripper_l_outer_joint3"
      type="revolute">
      <origin
        xyz="0.030852 0.018551 0"
        rpy="${PI} 0 0" />
      <parent
        link="gripper_l_outer_link1" />
      <child
        link="gripper_l_outer_link3" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-2"
        upper="2"
        effort="10"
        velocity="10" />
      <mimic joint="idx31_gripper_l_inner_joint1" multiplier="0.1" offset="0" />
    </joint>
    <link name="gripper_l_outer_link4">
      <inertial>
        <origin
          xyz="0.016206 0.0094593 4.7668E-05"
          rpy="0 0 0" />
        <mass
          value="0.035835" />
        <inertia
          ixx="8.5056E-06"
          ixy="-1.1363E-06"
          ixz="-4.2908E-11"
          iyy="1.1235E-05"
          iyz="-2.9251E-11"
          izz="4.6309E-06" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_dir}/gripper/omnipicker/outer_link4.dae" />
        </geometry>
        <!-- <material name="white" /> -->
      </visual>
      <xacro:if value="${collision_type == 'fine'}">
        <collision name="gripper_l_outer_link4_convex_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/gripper/omnipicker/convex/outer_link4.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="gripper_l_outer_link4_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint
      name="idx43_gripper_l_outer_joint4"
      type="revolute">
      <origin
        xyz="0.018118 0.01574 0"
        rpy="0 0 0" />
      <parent
        link="gripper_l_outer_link3" />
      <child
        link="gripper_l_outer_link4" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-2"
        upper="2"
        effort="10"
        velocity="10" />
      <mimic joint="idx31_gripper_l_inner_joint1" multiplier="-0.25" offset="0" />
    </joint>
    <link name="gripper_l_outer_link2">
      <inertial>
        <origin
          xyz="0.016268 0.0040555 0.00030323"
          rpy="0 0 0" />
        <mass
          value="0.025142" />
        <inertia
          ixx="5.887E-06"
          ixy="-1.1234E-07"
          ixz="2.1954E-11"
          iyy="6.236E-06"
          iyz="-9.473E-12"
          izz="6.2389E-07" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_dir}/gripper/omnipicker/outer_link2.dae" />
        </geometry>
        <!-- <material name="blue" /> -->
      </visual>
      <xacro:if value="${collision_type == 'fine'}">
