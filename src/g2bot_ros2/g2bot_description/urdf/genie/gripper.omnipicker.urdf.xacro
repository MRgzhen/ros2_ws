      <limit
        lower="-2"
        upper="2"
        effort="10"
        velocity="10" />
      <mimic joint="idx31_gripper_l_inner_joint1" multiplier="0.7" offset="0" />
    </joint>


    <!-- Gripper Finger Close-loop Structure -->
    <loop_joint name="idx53_gripper_l_outer_joint2" type="spherical">
      <link1
        link="gripper_l_base_link"
        xyz="0 0.012 0.105"
        rpy="-2.9951 -${PI_2} -0.15964" />
      <link2
        link="gripper_l_outer_link2"
        xyz="0 0 0"
        rpy="0 0 0" />
      <axis
        xyz="0 0 1" />
    </loop_joint>
    <loop_joint name="idx54_gripper_l_inner_joint2" type="spherical">
      <link1
        link="gripper_l_base_link"
        xyz="0 -0.012 0.105"
        rpy="-2.9951 -${PI_2} -0.15964" />
      <link2
        link="gripper_l_inner_link2"
        xyz="0 0 0"
        rpy="0 0 0" />
      <axis
        xyz="0 0 1" />
    </loop_joint>
  </xacro:macro>

  <xacro:macro
    name="gripper_r"
    params="tf_prefix parent_link xyz_offset rpy_offset visual_type collision_type mesh_dir app">

    <xacro:property name="camera_rpy_offset"
      value="${rpy_offset.split()[0]} ${rpy_offset.split()[1]} -${rpy_offset.split()[2]}" />
    <!-- camera link -->
    <link
      name="gripper_r_camera_link">
      <inertial>
        <origin
          xyz="0.012045 0.074409 0.04124"
          rpy="0 0 0" />
        <mass
          value="0.22805" />
        <inertia
          ixx="0.00033371"
          ixy="3.224E-05"
          ixz="1.4808E-05"
          iyy="0.00016245"
          iyz="0.00011846"
          izz="0.00033421" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="${mesh_dir}/gripper/omnipicker/camera_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.86667 0.86667 0.8902 1" />
        </material>
      </visual>
      <xacro:if value="${collision_type == 'fine' or collision_type == 'swept_hull'}">
        <collision name="gripper_r_camera_link_convex_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/omnipicker/convex/camera_link.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="gripper_r_camera_link_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>

    <joint
      name="idx70_gripper_r_camera_joint"
      type="fixed">
      <origin
        xyz="0 0 0"
        rpy="${camera_rpy_offset}" />
      <parent
        link="${parent_link}" />
      <child
        link="gripper_r_camera_link" />
      <axis
        xyz="0 0 0" />
    </joint>

    <!-- Gripper Base Connector -->
    <joint
      name="idx91_ee_r_joint"
      type="fixed">
      <origin
        xyz="${xyz_offset}"
        rpy="${rpy_offset}" />
      <parent
        link="${parent_link}" />
      <child
        link="gripper_r_base_link" />
      <axis
        xyz="0 0 0" />
    </joint>
    <!-- Gripper R-->
    <link name="gripper_r_base_link">
      <inertial>
        <origin
          xyz="-0.00013356 1.5301E-05 0.03322"
          rpy="0 0 0" />
        <mass
          value="0.23588" />
        <inertia
          ixx="8.1548E-05"
          ixy="-1.2617E-08"
          ixz="-2.05E-07"
          iyy="5.6921E-05"
          iyz="6.6903E-08"
          izz="7.1611E-05" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_dir}/gripper/omnipicker/base_link.dae" />
        </geometry>
        <!-- <material name="white" /> -->
      </visual>
      <xacro:if value="${collision_type == 'fine'}">
        <collision name="gripper_r_base_link_convex_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/gripper/omnipicker/convex/base_link.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="gripper_r_base_link_convex_0" />
        </collision_checking>
