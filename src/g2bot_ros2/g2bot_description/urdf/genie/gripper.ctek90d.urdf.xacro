<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- main xacro -->
  <xacro:macro
    name="gripper_l"
    params="tf_prefix parent_link xyz_offset rpy_offset visual_type collision_type mesh_dir app">

    <!-- Camera Link -->
    <link
      name="gripper_l_camera_link">
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="${mesh_dir}/gripper/ctek90d/camera_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.615686274509804 0.2 0.674509803921569 1" />
        </material>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="gripper_l_camera_link_collision_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/ctek90d/camera_link.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'fine' or collision_type == 'swept_hull'}">
        <collision name="gripper_l_camera_link_convex_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/ctek90d/swept_hull/left_camera_support.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="gripper_l_camera_link_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>

    <joint
      name="idx30_gripper_l_camera_joint"
      type="fixed">
      <origin
        xyz="0 0 0.0"
        rpy="${rpy_offset}" />
      <parent
        link="${parent_link}" />
      <child
        link="gripper_l_camera_link" />
      <axis
        xyz="0 0 0" />
    </joint>

    <!-- Gripper Base Connector -->
    <joint
      name="idx51_ee_l_joint"
      type="fixed">
      <origin
        xyz="${xyz_offset}"
        rpy="${rpy_offset}" />
      <parent
        link="${parent_link}" />
      <child
        link="gripper_l_base_link" />
      <axis
        xyz="0 0 0" />
    </joint>
    <!-- Gripper Base -->
    <link name="gripper_l_base_link">
      <inertial>
        <origin
          xyz="3.84872289645122E-06 -4.41448135187968E-05 0.0553867866771657"
          rpy="0 0 0" />
        <mass
          value="0.953455976099042" />
        <inertia
          ixx="0.00177628843801648"
          ixy="-8.19676071724033E-10"
          ixz="-3.00472546877836E-08"
          iyy="0.00187418176115802"
          iyz="-3.98009757950365E-07"
          izz="0.000875448946929789" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="${mesh_dir}/gripper/ctek90d/base_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.1 0.63921568627451 0.674509803921569 1" />
        </material>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="gripper_l_base_link_visual_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/ctek90d/base_link.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'swept_hull'}">
        <collision name="gripper_l_base_link_swept_hull_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/gripper/ctek90d/swept_hull/left_gripper.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="gripper_l_base_link_swept_hull_0" />
        </collision_checking>
      </xacro:if>
    </link>

    <!-- Left Inner Finger -->
    <link name="gripper_l_left_inner_link">
      <inertial>
        <origin
          xyz="0.0202604071221829 0.0187577877878552 2.21631403129407E-14"
          rpy="0 0 0" />
        <mass
          value="0.0309052898336314" />
        <inertia
          ixx="4.31215511674771E-06"
          ixy="-4.26885891149736E-06"
          ixz="-2.46366467847417E-13"
          iyy="4.97075221897906E-06"
          iyz="-2.22956225772745E-13"
          izz="9.19223373728399E-06" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="${mesh_dir}/gripper/ctek90d/left_inner_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.615686274509804 0.63921568627451 0.674509803921569 1" />
        </material>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="gripper_l_left_inner_link_visual_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/ctek90d/left_inner_link.STL" />
          </geometry>
        </collision>
      </xacro:if>
    </link>
    <joint
      name="idx31_gripper_l_inner_joint1"
      type="revolute">
      <origin
        xyz="0.016 0 0.121"
        rpy="${PI_2} 0 0" />
      <parent
        link="gripper_l_base_link" />
      <child
        link="gripper_l_left_inner_link" />
      <axis
        xyz="0 0 -1" />
      <limit
        lower="-0.91"
        upper="0"
        effort="0"
        velocity="0" />
    </joint>

    <!-- Left Outer Finger -->
    <link name="gripper_l_left_outer_link">
      <inertial>
        <origin
          xyz="0.0202604071221892 0.0187577877882694 2.20960470526592E-14"
          rpy="0 0 0" />
        <mass
          value="0.0309052898336316" />
        <inertia
          ixx="4.31215511677353E-06"
          ixy="-4.26885891149938E-06"
          ixz="-2.46366459463114E-13"
          iyy="4.9707522189533E-06"
          iyz="-2.22956217486463E-13"
          izz="9.19223373728405E-06" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="${mesh_dir}/gripper/ctek90d/left_outer_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.615686274509804 0.63921568627451 0.674509803921569 1" />
        </material>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="gripper_l_left_outer_link_visual_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/ctek90d/left_outer_link.STL" />
          </geometry>
        </collision>
      </xacro:if>
    </link>
    <joint
      name="idx32_gripper_l_outer_joint1"
      type="revolute">
      <origin
        xyz="0.030141 0 0.10415"
        rpy="${PI_2} 0 0" />
      <parent
        link="gripper_l_base_link" />
      <child
        link="gripper_l_left_outer_link" />
      <axis
        xyz="0 0 -1" />
      <limit
        lower="-0.91"
        upper="0"
        effort="10"
        velocity="10" />
      <mimic
        joint="idx31_gripper_l_inner_joint1"
        multiplier="1"
        offset="0" />
    </joint>

    <!-- Left Support Link -->
    <link name="gripper_l_left_support_link">
      <inertial>
        <origin
          xyz="-0.0177925864232372 0.0354308985297288 -3.45319167880073E-05"
          rpy="0 0 0" />
        <mass
          value="0.0828693338705683" />
        <inertia
          ixx="2.73957553511085E-05"
          ixy="7.04281105447926E-06"
          ixz="-1.08446711519888E-11"
          iyy="6.34802949004157E-06"
          iyz="1.18385736891846E-11"
          izz="2.83129237821216E-05" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="${mesh_dir}/gripper/ctek90d/left_support_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.615686274509804 0.63921568627451 0.674509803921569 1" />
        </material>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="gripper_l_support_link_visual_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/ctek90d/left_support_link.STL" />
          </geometry>
        </collision>
      </xacro:if>
    </link>
    <joint
      name="idx33_gripper_l_left_support_joint" type="revolute">
      <origin
        xyz="0.040359 0.037365 0"
        rpy="0 0 0" />
      <parent
        link="gripper_l_left_outer_link" />
      <child
        link="gripper_l_left_support_link" />
      <axis
        xyz="0 0 -1" />
      <limit
        lower="0"
        upper="0.91"
        effort="0"
        velocity="0" />
      <mimic
        joint="idx31_gripper_l_inner_joint1"
        multiplier="-1"
        offset="0" />
    </joint>

    <!-- Right Inner Finger -->
    <link name="gripper_l_right_inner_link">
      <inertial>
        <origin
          xyz="0.0202604071211299 0.0187577877883374 2.11370080968728E-14"
          rpy="0 0 0" />
        <mass
          value="0.0309052898336316" />
        <inertia
          ixx="4.31215511674775E-06"
          ixy="-4.2688589114974E-06"
          ixz="-2.46366382911271E-13"
          iyy="4.9707522189791E-06"
          iyz="-2.22956145920037E-13"
          izz="9.19223373728407E-06" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="${mesh_dir}/gripper/ctek90d/right_inner_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.615686274509804 0.63921568627451 0.674509803921569 1" />
        </material>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="gripper_l_right_inner_link_visual_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/ctek90d/right_inner_link.STL" />
          </geometry>
        </collision>
      </xacro:if>
    </link>
    <joint
      name="idx34_gripper_l_inner_joint2"
      type="revolute">
      <origin
        xyz="-0.016 0 0.121"
        rpy="${PI_2} 0 ${PI}" />
      <parent
        link="gripper_l_base_link" />
      <child
        link="gripper_l_right_inner_link" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="0"
        upper="0.91"
        effort="0"
        velocity="0" />
      <mimic
        joint="idx31_gripper_l_inner_joint1"
        multiplier="-1"
        offset="0" />
    </joint>

    <!-- Right Outer Finger -->
    <link name="gripper_l_right_outer_link">
      <inertial>
        <origin
          xyz="0.0202604071211989 0.0187577877891044 2.11409547592425E-14"
          rpy="0 0 0" />
        <mass
          value="0.0309052898336314" />
        <inertia
          ixx="4.3121551167735E-06"
          ixy="-4.26885891149935E-06"
          ixz="-2.46366386343243E-13"
          iyy="4.97075221895327E-06"
          iyz="-2.22956149418598E-13"
          izz="9.19223373728398E-06" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="${mesh_dir}/gripper/ctek90d/right_outer_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.615686274509804 0.63921568627451 0.674509803921569 1" />
        </material>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="gripper_l_right_outer_link_visual_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/ctek90d/right_outer_link.STL" />
          </geometry>
        </collision>
      </xacro:if>
    </link>
    <joint
      name="idx35_gripper_l_outer_joint2"
      type="revolute">
      <origin
        xyz="-0.030141 0 0.10415"
        rpy="${PI_2} 0 ${PI}" />
      <parent
        link="gripper_l_base_link" />
      <child
        link="gripper_l_right_outer_link" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="0"
        upper="0.91"
        effort="0"
        velocity="0" />
      <mimic
        joint="idx31_gripper_l_inner_joint1"
        multiplier="-1"
        offset="0" />
    </joint>

    <!-- Right Support Link -->
    <link name="gripper_l_right_support_link">
      <inertial>
        <origin
          xyz="-0.0177925878352495 0.0354308970643828 -2.81887513877937E-08"
          rpy="0 0 0" />
        <mass
          value="0.082869359674167" />
        <inertia
          ixx="2.73957568837024E-05"
          ixy="7.04281063834988E-06"
          ixz="-9.62685216616108E-12"
          iyy="6.34803242941661E-06"
          iyz="1.28138996747735E-11"
          izz="2.83129239152281E-05" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="${mesh_dir}/gripper/ctek90d/right_support_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.615686274509804 0.63921568627451 0.674509803921569 1" />
        </material>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="gripper_l_right_support_link_visual_0">
