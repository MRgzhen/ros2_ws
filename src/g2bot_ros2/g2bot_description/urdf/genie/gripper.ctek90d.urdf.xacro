          </geometry>
        </collision>
      </xacro:if>
    </link>
    <joint
      name="idx36_gripper_l_right_support_joint"
      type="revolute">
      <origin
        xyz="0.040359 0.037365 0"
        rpy="0 0 0" />
      <parent
        link="gripper_l_right_outer_link" />
      <child
        link="gripper_l_right_support_link" />
      <axis
        xyz="0 0 -1" />
      <limit
        lower="0"
        upper="0.91"
        effort="0"
        velocity="0" />
      <mimic
        joint="idx31_gripper_l_inner_joint1"
        multiplier="-1"
        offset="0" />
    </joint>

  </xacro:macro>

  <xacro:macro
    name="gripper_r"
    params="tf_prefix parent_link xyz_offset rpy_offset visual_type collision_type mesh_dir app">

    <!-- Camera Link -->
    <link
      name="gripper_r_camera_link">
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="${mesh_dir}/gripper/ctek90d/camera_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.615686274509804 0.2 0.674509803921569 1" />
        </material>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="gripper_r_camera_link_collision_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/ctek90d/camera_link.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'fine' or collision_type == 'swept_hull'}">
        <collision name="gripper_r_camera_link_convex_0">
