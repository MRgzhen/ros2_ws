      </xacro:if>
    </link>

    <!-- Left Inner Finger -->
    <link name="gripper_r_left_inner_link">
      <inertial>
        <origin
          xyz="0.0202604071221829 0.0187577877878552 2.21631403129407E-14"
          rpy="0 0 0" />
        <mass
          value="0.0309052898336314" />
        <inertia
          ixx="4.31215511674771E-06"
          ixy="-4.26885891149736E-06"
          ixz="-2.46366467847417E-13"
