    <!-- Gripper Base -->
    <link name="gripper_r_base_link">
      <inertial>
        <origin
          xyz="3.84872289645122E-06 -4.41448135187968E-05 0.0553867866771657"
          rpy="0 0 0" />
        <mass
          value="0.953455976099042" />
        <inertia
