    </joint>

    <!-- Left Outer Finger -->
    <link name="gripper_r_left_outer_link">
      <inertial>
        <origin
          xyz="0.0202604071221892 0.0187577877882694 2.20960470526592E-14"
          rpy="0 0 0" />
        <mass
          value="0.0309052898336316" />
        <inertia
          ixx="4.31215511677353E-06"
          ixy="-4.26885891149938E-06"
          ixz="-2.46366459463114E-13"
          iyy="4.9707522189533E-06"
