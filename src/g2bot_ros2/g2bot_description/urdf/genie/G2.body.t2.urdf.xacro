        </xacro:if>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="head_link3_visual_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/G2/T2/head_link3.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'fine' or collision_type == 'coarse'}">
        <collision name="head_link3_convex_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/G2/T2/convex/head_link3.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="head_link3_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint
      name="idx13_head_joint3"
      type="revolute">
      <origin
        xyz="-0.03035 0 0"
        rpy="0 0 0" />
      <parent
        link="head_link2" />
      <child
        link="head_link3" />
      <axis
        xyz="0 1 0" />
      <limit
        lower="-0.0181"
        upper="0.5231"
        effort="50"
        velocity="2.5" />
    </joint>

  </xacro:macro>
</robot>
