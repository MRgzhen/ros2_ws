        upper="1.039"
        effort="50"
        velocity="1.21" />
    </joint>
    <link name="body_link4">
      <inertial>
        <origin
          xyz="-0.0714497732220123 -6.54615430835531E-05 0.0300405432603843"
          rpy="0 0 0" />
        <mass
          value="6.23060984301658" />
        <inertia
