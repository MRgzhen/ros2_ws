          ixy="4.12661173047439E-05"
          ixz="0.00171366593325419"
          iyy="0.0315396763705882"
          iyz="1.37672137570577E-05"
          izz="0.0278671278403372" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <xacro:if value="${visual_type == 'stl'}">
          <geometry>
            <mesh
