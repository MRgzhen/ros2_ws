<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="body"
    params="arm_base_link visual_type collision_type mesh_dir app has_battery">
    <!-- properties -->
    <!-- Base -->
    <link
      name="base_link">

      <!-- 根据是否有电池选择不同的惯性参数 -->
      <xacro:unless value="${has_battery}">
        <!-- 无电池配置：质量较轻，重心位置和惯性张量相应调整 -->
        <inertial>
          <origin
            xyz="-0.004162 -1.1E-05 0.104728"
            rpy="0 0 0" />
          <mass
            value="65.21" />
          <inertia
            ixx="2.6441"
            ixy="-0.03595"
            ixz="0.056346"
            iyy="2.2606"
            iyz="-0.000871"
            izz="3.9751" />
        </inertial>
      </xacro:unless>
      <xacro:if value="${has_battery}">
        <!-- 有电池配置：包含电池质量，重心位置和惯性张量相应调整（默认配置） -->
        <inertial>
          <origin
            xyz="-0.0034754 0.0061443 0.096655"
            rpy="0 0 0" />
          <mass
            value="80" />
          <inertia
            ixx="0.7115"
            ixy="-1.6509E-05"
            ixz="0.011945"
            iyy="0.82339"
            iyz="-3.6042E-05"
            izz="1.3573" />
        </inertial>
      </xacro:if>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <xacro:if value="${visual_type == 'stl'}">
          <geometry>
            <mesh
              filename="${mesh_dir}/G2/T2/base_link.STL" />
          </geometry>
          <material name="white" />
        </xacro:if>
        <xacro:if value="${visual_type == 'fbx'}">
          <geometry>
            <mesh
              filename="${mesh_dir}/G2/T2/base_link.fbx" />
          </geometry>
        </xacro:if>
      </visual>

      <xacro:if value="${collision_type == 'visual'}">
        <collision name="base_link_visual_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/G2/T2/base_link.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'coarse' or collision_type == 'fine'}">
        <collision name="base_link_coarse_0">
          <geometry>
            <box size="0.62673163 0.17409083 0.3258258" />
          </geometry>
          <origin xyz="0.011247277 -0.23094544 0.16291195" rpy="0.0 -0.0 0.0" />
        </collision>
        <collision name="base_link_coarse_1">
          <geometry>
            <box size="0.62667394 0.18714839 0.3258258" />
          </geometry>
          <origin xyz="0.011277318 0.23441666 0.16291195" rpy="0.0 -0.0 0.0" />
        </collision>
        <collision name="base_link_coarse_2">
          <geometry>
            <box size="0.6246023 0.23870158 0.06967827" />
          </geometry>
          <origin xyz="0.01230073 -0.01307106 0.11483914" rpy="0.0 -0.0 0.0" />
        </collision>
        <collision name="base_link_coarse_3">
          <geometry>
            <mesh filename="${mesh_dir}/G2/T2/convex/base_link_1.STL" />
          </geometry>
        </collision>
        <collision name="base_link_coarse_4">
          <geometry>
            <mesh filename="${mesh_dir}/G2/T2/convex/base_link_2.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="base_link_coarse_3" />
          <convex name="base_link_coarse_4" />
        </collision_checking>
      </xacro:if>
    </link>

    <link name="body_link1">
      <inertial>
        <origin
          xyz="-0.00489400639408126 0.000193106698721912 0.175561673292876"
          rpy="0 0 0" />
        <mass
          value="20.7873543330424" />
        <inertia
          ixx="0.261032758003677"
          ixy="0.000602528716197084"
          ixz="-1.29680162892322E-05"
          iyy="0.260630471698783"
          iyz="-0.000709763689000467"
          izz="0.059577479809498" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <xacro:if value="${visual_type == 'stl'}">
          <geometry>
            <mesh
              filename="${mesh_dir}/G2/T2/body_link1.STL" />
          </geometry>
          <material name="default" />
        </xacro:if>
        <xacro:if value="${visual_type == 'fbx'}">
          <geometry>
            <mesh
              filename="${mesh_dir}/G2/T2/body_link1.fbx" />
          </geometry>
        </xacro:if>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="body_link1_visual_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/G2/T2/body_link1.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'fine' or collision_type == 'coarse'}">
        <collision name="Cylinder">
          <origin xyz="0.000000 0.000000 0.000000"
            rpy="1.570796 -0.000000 0.000000" />
          <geometry>
            <cylinder radius="0.089146" length="0.153391" />
          </geometry>
        </collision>

        <collision name="Cylinder.001">
          <origin xyz="0.000000 0.000000 0.360000"
            rpy="1.570796 -0.000000 0.000000" />
          <geometry>
            <cylinder radius="0.089146" length="0.153391" />
          </geometry>
        </collision>

        <collision name="Cube">
          <origin xyz="-0.024457 0.000000 0.180000"
            rpy="0.000000 0.000000 0.000000" />
          <geometry>
            <box size="0.085594 0.176618 0.351288" />
          </geometry>
        </collision>

        <collision name="Cube.001">
          <origin xyz="-0.009824 0.075429 0.180136"
            rpy="0.000000 0.000000 0.000000" />
          <geometry>
            <box size="0.112587 0.027062 0.240828" />
          </geometry>
        </collision>

        <collision name="Cube.002">
          <origin xyz="-0.009824 -0.075429 0.180136"
            rpy="0.000000 0.000000 0.000000" />
          <geometry>
            <box size="0.112587 0.027062 0.240828" />
          </geometry>
        </collision>
      </xacro:if>
    </link>
    <joint
      name="idx01_body_joint1"
      type="revolute">
      <origin
        xyz="0.102 0 0.144"
        rpy="0 0 0" />
      <parent
        link="base_link" />
      <child
        link="body_link1" />
      <axis
        xyz="0 1 0" />
      <limit
        lower="-1.0822"
        upper="0.0001"
        effort="50"
        velocity="1.21" />
    </joint>
    <link name="body_link2">
      <inertial>
        <origin
          xyz="0.00254034356479389 -0.0437019539573708 0.185408475115362"
          rpy="0 0 0" />
        <mass
          value="12.4097528419251" />
        <inertia
          ixx="0.195214319300036"
          ixy="-2.0467554323506E-05"
          ixz="0.00360134174333636"
          iyy="0.208364581033745"
          iyz="-4.02135855207347E-05"
          izz="0.0221456249678955" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <xacro:if value="${visual_type == 'stl'}">
