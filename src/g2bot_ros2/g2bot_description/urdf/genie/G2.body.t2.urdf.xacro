      </xacro:if>
      <xacro:if value="${collision_type == 'fine' or collision_type == 'coarse'}">
        <collision name="body_link2_convex_0">
          <geometry>
            <mesh filename="${mesh_dir}/G2/T2/convex/body_link2.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="body_link2_convex_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint
      name="idx02_body_joint2"
