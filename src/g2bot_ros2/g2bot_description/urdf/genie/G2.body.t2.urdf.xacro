        upper="0.4364"
        effort="50"
        velocity="1.21" />
    </joint>
    <link name="body_link5">
      <inertial>
        <origin
          xyz="-0.0244423519676249 0.000202655359185969 0.136945087391502"
          rpy="0 0 0" />
        <mass
          value="7.9008845440508" />
        <inertia
