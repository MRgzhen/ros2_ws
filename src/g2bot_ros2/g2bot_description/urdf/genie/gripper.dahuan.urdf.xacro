        <mass
          value="0.0" />
        <inertia
          ixx="4.374e-05"
          ixy="6e-07"
          ixz="-6.36e-06"
          iyy="4.481e-05"
          iyz="2.74e-06"
          izz="3.42e-06" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="${mesh_dir}/gripper/dahuan/finger_link1.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.77647 0.75686 0.73725 1" />
        </material>
      </visual>
      <xacro:if value="${collision_type != 'swept_hull'}">
        <collision name="gripper_r_outer_link1_convex_00">
