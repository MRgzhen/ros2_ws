            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/dahuan/convex/finger_link1_collision01.STL" />
          </geometry>
        </collision>
        <collision name="gripper_r_outer_link1_convex_01">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/dahuan/convex/finger_link1_collision02.STL" />
          </geometry>
        </collision>
        <collision name="gripper_r_outer_link1_convex_02">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
