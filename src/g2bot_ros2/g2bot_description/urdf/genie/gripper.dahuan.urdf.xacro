      <origin
        xyz="0.0265 -0.0134 0.098"
        rpy="0 0 ${PI_2}" />
      <parent
        link="gripper_r_base_link" />
      <child
        link="gripper_r_outer_link1" />
      <axis
        xyz="0 1 0" />
      <limit
        lower="0"
        upper="0.025"
        effort="0"
        velocity="0" />
      <mimic
        joint="idx71_gripper_r_inner_joint1"
        multiplier="1"
        offset="0" />
    </joint>
    <joint
      name="idx71_gripper_r_inner_joint1"
      type="prismatic">
      <origin
        xyz="-0.0265 0.0134 0.098"
        rpy="0 0 -${PI_2}" />
      <parent
        link="gripper_r_base_link" />
      <child
        link="gripper_r_inner_link1" />
      <axis
        xyz="0 1 0" />
      <limit
        lower="0"
        upper="0.025"
