        </collision>
        <collision_checking>
          <convex name="gripper_r_outer_link1_convex_00" />
          <convex name="gripper_r_outer_link1_convex_01" />
          <convex name="gripper_r_outer_link1_convex_02" />
        </collision_checking>
      </xacro:if>
    </link>
    <link
      name="gripper_r_inner_link1">
      <inertial>
        <origin
          xyz="0.01783814 0.06539712 0.04630186"
          rpy="0 0 0" />
        <mass
          value="0.0" />
        <inertia
          ixx="4.481e-05"
          ixy="3.1e-07"
          ixz="-2.76e-06"
          iyy="4.528e-05"
          iyz="-2.8e-06"
          izz="2.86e-06" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="${mesh_dir}/gripper/dahuan/finger_link2.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.77647 0.75686 0.73725 1" />
