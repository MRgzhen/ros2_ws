<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro
    name="gripper_l"
    params="tf_prefix parent_link xyz_offset rpy_offset center_z_offset mesh_dir collision_type:='swept_hull'">

    <link
      name="gripper_l_base_link">
      <inertial>
        <origin
          xyz="-0.012821 -0.004486 0.059606"
          rpy="0 0 0" />
        <mass
          value="1.1848327534061049" />
        <inertia
          ixx="0.0028087"
          ixy="-0.00059494"
          ixz="-0.00022416"
          iyy="0.00130123"
          iyz="-0.00068015"
          izz="0.00279029" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="${mesh_dir}/gripper/dahuan/base_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.86667 0.86667 0.8902 1" />
        </material>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision name="gripper_l_base_link_visual_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/dahuan/base_link.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'fine' or collision_type == 'coarse'}">
        <collision name="gripper_l_base_link_convex_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/dahuan/base_link.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="gripper_l_base_link_convex_0" />
        </collision_checking>
      </xacro:if>
      <xacro:if value="${collision_type == 'swept_hull'}">
        <collision name="gripper_l_base_link_swept_hull_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/dahuan/swept_hull/left_gripper.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="gripper_l_base_link_swept_hull_0" />
        </collision_checking>
      </xacro:if>
    </link>
    <link
      name="gripper_l_outer_link1">
      <inertial>
        <origin
          xyz="0.01518084 -0.01233022 0.04569629"
          rpy="0 0 0" />
        <mass
          value="0.0" />
        <inertia
          ixx="4.374e-05"
          ixy="6e-07"
          ixz="-6.36e-06"
          iyy="4.481e-05"
          iyz="2.74e-06"
          izz="3.42e-06" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="${mesh_dir}/gripper/dahuan/finger_link1.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.77647 0.75686 0.73725 1" />
        </material>
      </visual>
      <xacro:if value="${collision_type != 'swept_hull'}">
        <collision name="gripper_l_outer_link1_convex_00">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/dahuan/convex/finger_link1_collision01.STL" />
          </geometry>
        </collision>
        <collision name="gripper_l_outer_link1_convex_01">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/dahuan/convex/finger_link1_collision02.STL" />
          </geometry>
        </collision>
        <collision name="gripper_l_outer_link1_convex_02">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/dahuan/convex/finger_link1_collision03.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="gripper_l_outer_link1_convex_00" />
          <convex name="gripper_l_outer_link1_convex_01" />
          <convex name="gripper_l_outer_link1_convex_02" />
        </collision_checking>
      </xacro:if>
    </link>
    <link
      name="gripper_l_inner_link1">
      <inertial>
        <origin
          xyz="0.01783814 0.06539712 0.04630186"
          rpy="0 0 0" />
        <mass
          value="0.0" />
        <inertia
          ixx="4.481e-05"
          ixy="3.1e-07"
          ixz="-2.76e-06"
          iyy="4.528e-05"
          iyz="-2.8e-06"
          izz="2.86e-06" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="${mesh_dir}/gripper/dahuan/finger_link2.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.77647 0.75686 0.73725 1" />
        </material>
      </visual>
      <xacro:if value="${collision_type != 'swept_hull'}">
        <collision name="gripper_l_inner_link1_convex_00">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/dahuan/convex/finger_link2_collision01.STL" />
          </geometry>
        </collision>
        <collision name="gripper_l_inner_link1_convex_01">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/dahuan/convex/finger_link2_collision02.STL" />
          </geometry>
        </collision>
        <collision name="gripper_l_inner_link1_convex_02">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/gripper/dahuan/convex/finger_link2_collision03.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="gripper_l_inner_link1_convex_00" />
          <convex name="gripper_l_inner_link1_convex_01" />
          <convex name="gripper_l_inner_link1_convex_02" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint
      name="idx41_gripper_l_outer_joint1"
      type="prismatic">
      <origin
        xyz="0.0265 -0.0134 0.098"
        rpy="0 0 ${PI_2}" />
      <parent
        link="gripper_l_base_link" />
      <child
        link="gripper_l_outer_link1" />
      <axis
        xyz="0 1 0" />
      <limit
        lower="0"
        upper="0.025"
        effort="0"
        velocity="0" />
      <mimic
        joint="idx31_gripper_l_inner_joint1"
        multiplier="1"
        offset="0" />
    </joint>
    <joint
      name="idx31_gripper_l_inner_joint1"
      type="prismatic">
      <origin
        xyz="-0.0265 0.0134 0.098"
        rpy="0 0 -${PI_2}" />
      <parent
        link="gripper_l_base_link" />
      <child
        link="gripper_l_inner_link1" />
      <axis
        xyz="0 1 0" />
      <limit
        lower="0"
        upper="0.025"
        effort="0"
        velocity="0" />
    </joint>

    <!-- Gripper Connector -->
    <joint
      name="idx51_ee_l_joint"
      type="fixed">
      <origin
        xyz="${xyz_offset}"
        rpy="${rpy_offset}" />
      <parent
        link="${parent_link}" />
      <child
        link="gripper_l_base_link" />
      <axis
        xyz="0 0 0" />
    </joint>
    <link name="gripper_l_center_link">
    </link>
    <joint name="idx52_gripper_l_center_joint" type="fixed">
      <origin rpy="0 0 -${PI_2}" xyz="0.0 0.0 ${center_z_offset}" />
      <parent link="gripper_l_base_link" />
      <child link="gripper_l_center_link" />
    </joint>


    <link name="gripper_l_tcp">
    </link>
    <joint
      name="idx53_ee_l_joint"
      type="fixed">
      <origin
        xyz="-0.011 0.0 0.186"
        rpy="2.6179853108 0.0 1.5707963268"/>
      <parent
        link="${parent_link}" />
      <child
        link="gripper_l_tcp" />
      <axis
        xyz="0 0 0" />
    </joint>

  </xacro:macro>

  <xacro:macro
    name="gripper_r"
    params="tf_prefix parent_link xyz_offset rpy_offset center_z_offset mesh_dir collision_type:='swept_hull'">

    <link
      name="gripper_r_base_link">
      <inertial>
        <origin
          xyz="-0.012821 -0.004486 0.059606"
