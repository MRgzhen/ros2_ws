<?xml version="1.0"?>
<robot name="G2L" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="G2L"
    params="body arm lgripper rgripper visual_type collision_type mesh_dir app">
    <!-- properties -->
    <xacro:property name="arm_base_link" value="arm_base_link" />
    <xacro:property name="left_arm_end_link" value="arm_l_end_link" />
    <xacro:property name="right_arm_end_link" value="arm_r_end_link" />

    <!-- import robot components -->
    <!-- body -->
    <xacro:include ns="lg_body" filename="G2L.body.lg.urdf.xacro" />
    <!-- chassis -->
    <xacro:include ns="lg_chassis" filename="G2L.chassis.lg.urdf.xacro" />
    <!-- arm -->
    <xacro:include ns="crs" filename="G2.arm.crs.urdf.xacro" />
    <!-- gripper -->
    <xacro:include filename="G2.gripper.urdf.xacro" />

    <!-- assemble robot -->

    <!-- ======================== body ======================== -->
    <xacro:if value="${'lg' == body}">
      <xacro:lg_chassis.chassis
        visual_type="${visual_type}"
        collision_type="${collision_type}"
        mesh_dir="${mesh_dir}"
        app="${app}" />
      <xacro:lg_body.body
        arm_base_link="${arm_base_link}"
        visual_type="${visual_type}"
        collision_type="${collision_type}"
        mesh_dir="${mesh_dir}"
        app="${app}" />
    </xacro:if>

    <!-- ======================== arm ======================== -->
    <xacro:if value="${'crs' == arm}">
      <xacro:crs.arm_l
        parent_link="${arm_base_link}"
        xyz_offset="0 0 0.0455"
        rpy_offset="0 0 0"
        end_link="${left_arm_end_link}"
        visual_type="${visual_type}"
        collision_type="${collision_type}"
        mesh_dir="${mesh_dir}"
        app="${app}" />
      <xacro:crs.arm_r
        parent_link="${arm_base_link}"
        xyz_offset="0 0 -0.0455"
        rpy_offset="${PI} 0 0"
        end_link="${right_arm_end_link}"
        visual_type="${visual_type}"
        collision_type="${collision_type}"
        mesh_dir="${mesh_dir}"
        app="${app}" />
    </xacro:if>

    <!-- ======================== gripper ======================== -->
    <xacro:gripper
      lgripper="${lgripper}"
      rgripper="${rgripper}"
      left_arm_end_link="${left_arm_end_link}"
      right_arm_end_link="${right_arm_end_link}"
      visual_type="${visual_type}"
      collision_type="${collision_type}"
      mesh_dir="${mesh_dir}"
      app="${app}" />

  </xacro:macro>
</robot>
