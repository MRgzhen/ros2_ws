<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="body" params="arm_base_link visual_type collision_type mesh_dir app has_battery">
    <!-- properties -->
    <!-- Base -->
    <link
      name="base_link">
      <!-- 根据是否有电池选择不同的惯性参数 -->
      <xacro:unless value="${has_battery}">
        <!-- 无电池配置：质量较轻，重心位置和惯性张量相应调整 -->
        <inertial>
          <origin
            xyz="0.002517 0.001069 0.120927"
            rpy="0 0 0" />
          <mass
            value="51.672980" />
          <inertia
            ixx="1.743053"
            ixy="0.000819"
            ixz="0.011129"
            iyy="2.558596"
            iyz="-0.002300"
            izz="3.341087" />
        </inertial>
      </xacro:unless>
      <xacro:if value="${has_battery}">
        <!-- 有电池配置：包含电池质量，重心位置和惯性张量相应调整（默认配置） -->
        <inertial>
          <origin
            xyz="0.00149 -0.002673 0.117552"
            rpy="0 0 0" />
          <mass
            value="74" />
          <inertia
            ixx="3.032489"
            ixy="-0.003519"
            ixz="0.010648"
            iyy="2.833502"
            iyz="-0.000989"
            izz="4.644149" />
        </inertial>
      </xacro:if>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
          
        <geometry>
          <mesh
            filename="${mesh_dir}/G2/T1/base_link.STL" />
        </geometry>
        <material name="white" />
      </visual>

      <xacro:if value="${collision_type == 'visual'}">
        <collision name="base_link_visual_0">
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/G2/T1/base_link.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'coarse' or collision_type == 'fine'}">
        <collision name="base_link_coarse_0">
          <geometry>
            <box size="0.62673163 0.17409083 0.3258258" />
          </geometry>
          <origin xyz="0.011247277 -0.23094544 0.16291195" rpy="0.0 -0.0 0.0" />
        </collision>
        <collision name="base_link_coarse_1">
          <geometry>
            <box size="0.62667394 0.18714839 0.3258258" />
          </geometry>
          <origin xyz="0.011277318 0.23441666 0.16291195" rpy="0.0 -0.0 0.0" />
        </collision>
        <collision name="base_link_coarse_2">
          <geometry>
            <box size="0.6246023 0.23870158 0.06967827" />
          </geometry>
          <origin xyz="0.01230073 -0.01307106 0.11483914" rpy="0.0 -0.0 0.0" />
        </collision>
      </xacro:if>
    </link>

    <link name="body_link1">
      <inertial>
        <origin
          xyz="-0.107323 -0.039185 0.050115"
