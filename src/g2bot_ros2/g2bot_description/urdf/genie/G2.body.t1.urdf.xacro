        <mass
          value="14.129" />
        <inertia
          ixx="0.151776"
          ixy="-0.023402"
          ixz="0.090707"
          iyy="0.276733"
          iyz="0.010903"
          izz="0.304201" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="${mesh_dir}/G2/T1/body_link1.STL" />
        </geometry>
        <material name="default" />
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
