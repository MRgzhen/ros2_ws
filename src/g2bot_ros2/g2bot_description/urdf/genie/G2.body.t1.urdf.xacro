            <box size="0.146916653064989 0.21210148364482734 0.4984007347291842" />
          </geometry>
          <origin xyz="-0.15756349693645624 -0.0027857167676530476 0.07797823284372236"
            rpy="3.131859512133172 1.1132561689202216 3.1309874363998365" />
        </collision>
      </xacro:if>
    </link>
    <joint
      name="idx01_body_joint1"
      type="revolute">
      <origin
        xyz="0.102 0 0.144"
        rpy="0 0.0 0" />
      <parent
        link="base_link" />
      <child
        link="body_link1" />
      <axis
        xyz="0 1 0" />
      <limit
        lower="0"
        upper="1.18"
        effort="300"
        velocity="1.15" />
    </joint>
    <link name="body_link2">
      <inertial>
        <origin
          xyz="0.014787 -0.004305 -4.7E-05"
          rpy="0 0 0" />
        <mass
          value="8.5" />
        <inertia
          ixx="0.037974"
          ixy="-0.00042"
          ixz="-0.000627"
          iyy="0.043889"
