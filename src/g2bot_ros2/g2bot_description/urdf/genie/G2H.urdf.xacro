<?xml version="1.0"?>
<robot name="G2H" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="G2H"
    params="body arm lgripper rgripper visual_type collision_type mesh_dir app">
    <!-- properties -->
    <xacro:property name="arm_base_link" value="arm_base_link" />
    <xacro:property name="left_arm_end_link" value="arm_l_end_link" />
    <xacro:property name="right_arm_end_link" value="arm_r_end_link" />
    <xacro:property name="has_battery" value="true" />

    <!-- import robot components -->
    <!-- body -->
    <xacro:include ns="t0" filename="G2H.body.t0.urdf.xacro" />

    <!-- chassis -->
    <xacro:include filename="G2H.chassis.t0.urdf.xacro" />

    <!-- arm -->
    <xacro:include ns="acs" filename="G2H.arm.acs.urdf.xacro" />

    <!-- assemble robot -->
    <!-- ======================== body ======================== -->
    <!-- t0 -->
    <xacro:if value="${'t0' == body}">
      <xacro:t0.body
        arm_base_link="${arm_base_link}"
        visual_type="${visual_type}"
        collision_type="${collision_type}"
        mesh_dir="${mesh_dir}"
        app="${app}" />
    </xacro:if>

    <!-- ======================== chassis ======================== -->
    <xacro:chassis
      visual_type="${visual_type}"
      collision_type="${collision_type}"
      mesh_dir="${mesh_dir}"
      app="${app}" />

    <!-- ======================== arm ============================ -->
    <!-- acs -->
    <xacro:if value="${'acs' == arm}">
      <xacro:acs.arm_l
        parent_link="${arm_base_link}"
        xyz_offset="0 0.059139059387254 0.0104278117836938"
        rpy_offset="-1.39626340159547 0 0"
        end_link="${left_arm_end_link}"
        visual_type="${visual_type}"
        collision_type="${collision_type}"
        mesh_dir="${mesh_dir}"
        app="${app}" />
      <xacro:acs.arm_r
        parent_link="${arm_base_link}"
        xyz_offset="0 -0.0591390593872678 0.0104278117836944"
        rpy_offset="1.39626340159547 0 0"
        end_link="${right_arm_end_link}"
        visual_type="${visual_type}"
        collision_type="${collision_type}"
        mesh_dir="${mesh_dir}"
        app="${app}" />
    </xacro:if>
  </xacro:macro>
</robot>
