        thumb=dict([(1, 0.0075), (2, 0.0248), (3, 0.0165), (4, 0.0165), (5, 0.0041)]),
        other=dict([(1, 0.0032), (2, 0.033), (3, 0.0165), (4, 0.014), (5, 0.00318)]))}" />

