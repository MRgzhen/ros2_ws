    </joint>

    <link name="gripper_object">
      <visual>
        <origin rpy="0 0 1.5708" xyz="0 0 0" />
        <geometry>
          <mesh filename="package://genie_robot_description/meshes/gripper/dahuan_junsheng/Object.STL" />
