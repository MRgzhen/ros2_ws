        </geometry>
      </collision>
      <collision_checking>
        <convex name="gripper_l_inner_link1_convex_00" />
        <convex name="gripper_l_inner_link1_convex_01" />
        <convex name="gripper_l_inner_link1_convex_02" />
      </collision_checking>
    </link>
    <joint
      name="idx41_gripper_l_outer_joint1"
      type="prismatic">
      <origin
        xyz="0.0265 -0.0134 0.098"
        rpy="0 0 ${PI_2}" />
      <parent
        link="gripper_l_base_link" />
      <child
        link="gripper_l_outer_link1" />
      <axis
        xyz="0 1 0" />
      <limit
        lower="0"
        upper="0.025"
        effort="0"
        velocity="0" />
      <mimic
        joint="idx31_gripper_l_inner_joint1"
        multiplier="1"
        offset="0" />
    </joint>
    <joint
      name="idx31_gripper_l_inner_joint1"
      type="prismatic">
      <origin
        xyz="-0.0265 0.0134 0.098"
        rpy="0 0 -${PI_2}" />
      <parent
        link="gripper_l_base_link" />
      <child
        link="gripper_l_inner_link1" />
      <axis
        xyz="0 1 0" />
      <limit
        lower="0"
        upper="0.025"
        effort="0"
        velocity="0" />
    </joint>

    <!-- Gripper Connector -->
    <joint
      name="idx51_ee_l_joint"
      type="fixed">
      <origin
        xyz="${xyz_offset}"
        rpy="${rpy_offset}" />
      <parent
        link="${parent_link}" />
      <child
        link="gripper_l_base_link" />
      <axis
        xyz="0 0 0" />
    </joint>

  </xacro:macro>

