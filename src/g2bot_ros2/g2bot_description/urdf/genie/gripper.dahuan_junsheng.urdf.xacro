<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro
    name="gripper_l"
    params="tf_prefix parent_link xyz_offset rpy_offset mesh_dir">

    <link
      name="gripper_l_base_link">
      <inertial>
        <origin
          xyz="-0.012821 -0.004486 0.059606"
          rpy="0 0 0" />
        <mass
          value="1.1848327534061049" />
        <inertia
          ixx="0.0028087"
          ixy="-0.00059494"
          ixz="-0.00022416"
          iyy="0.00130123"
          iyz="-0.00068015"
          izz="0.00279029" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="${mesh_dir}/gripper/dahuan_junsheng/base_link.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.86667 0.86667 0.8902 1" />
        </material>
      </visual>
      <collision name="gripper_l_base_link_convex_0">
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="${mesh_dir}/gripper/dahuan_junsheng/base_link.STL" />
        </geometry>
      </collision>
      <collision_checking>
        <convex name="gripper_l_base_link_convex_0" />
      </collision_checking>
    </link>
    <link
      name="gripper_l_outer_link1">
      <inertial>
        <origin
          xyz="0.01518084 -0.01233022 0.04569629"
          rpy="0 0 0" />
        <mass
          value="0.0" />
        <inertia
          ixx="4.374e-05"
          ixy="6e-07"
          ixz="-6.36e-06"
          iyy="4.481e-05"
          iyz="2.74e-06"
          izz="3.42e-06" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
