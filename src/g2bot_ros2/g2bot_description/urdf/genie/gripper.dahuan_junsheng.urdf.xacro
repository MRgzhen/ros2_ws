          rpy="0 0 0" />
        <geometry>
          <mesh
            filename="${mesh_dir}/scene/junpu/junpu.STL" />
        </geometry>
        <material
          name="">
          <color
            rgba="0.86667 0.86667 0.8902 1" />
        </material>
      </visual>
      <collision name="workspace_collision_convex_01">
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
