<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="thumb"
        params="name start_id mirror mirror_mesh mesh_path collision_type *origin">

        <!-- thumb roll -->
        <joint name="idx${start_id}_${name}_thumb_roll_joint" type="revolute">
            <origin xyz="${thumb_roll_x} ${thumb_roll_y*mirror} ${thumb_roll_z}" rpy="0 0 0" />
            <parent link="${name}_base_link" />
            <child link="${name}_thumb_roll_link" />
            <axis xyz="1 0 0" />
            <xacro:if value="${mirror_mesh == True}">
                <limit effort="${thumb_roll_torque_max}" velocity="${thumb_roll_velocity_max}"
                    lower="${thumb_roll_position_max*mirror}"
                    upper="${thumb_roll_position_min*mirror}" />
            </xacro:if>
            <xacro:if value="${mirror_mesh == False}">
                <limit effort="${thumb_roll_torque_max}" velocity="${thumb_roll_velocity_max}"
                    lower="${thumb_roll_position_min}" upper="${thumb_roll_position_max}" />
            </xacro:if>
        </joint>
        <link name="${name}_thumb_roll_link">
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${thumb_roll_com_x} ${thumb_roll_com_y*mirror} ${thumb_roll_com_z}" />
                <mass value="${thumb_roll_mass}" />
                <inertia
                    ixx="${thumb_roll_ixx}" ixy="${thumb_roll_ixy*mirror}"
                    ixz="${thumb_roll_ixz}"
                    iyy="${thumb_roll_iyy}" iyz="${thumb_roll_iyz*mirror}" izz="${thumb_roll_izz}" />
            </inertial>
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <xacro:if value="${mirror_mesh == True}">
                        <mesh filename="${mesh_path}/l_thumb_roll.STL" />
                    </xacro:if>
                    <xacro:if value="${mirror_mesh == False}">
                        <mesh filename="${mesh_path}/r_thumb_roll.STL" />
                    </xacro:if>
                </geometry>
                <material name="blue" />
            </visual>
            <xacro:if value="${collision_type == 'fine'}">
                <collision name="${name}_thumb_roll_link_convex_0">
                    <origin rpy="0 0 0" xyz="0 0 0" />
                    <geometry>
                        <xacro:if value="${mirror_mesh == True}">
                            <mesh filename="${mesh_path}/collision/l_thumb_roll_col.STL" />
                        </xacro:if>
                        <xacro:if value="${mirror_mesh == False}">
                            <mesh filename="${mesh_path}/collision/r_thumb_roll_col.STL" />
                        </xacro:if>
                    </geometry>
                </collision>
                <collision_checking>
                    <convex name="${name}_thumb_roll_link_convex_0" />
                </collision_checking>
            </xacro:if>
        </link>

        <!-- thumb abad -->
        <joint name="idx${start_id+1}_${name}_thumb_abad_joint" type="revolute">
            <origin xyz="${thumb_abad_x} ${thumb_abad_y*mirror} ${thumb_abad_z}" rpy="0 0 0" />
            <parent link="${name}_thumb_roll_link" />
            <child link="${name}_thumb_abad_link" />
            <axis xyz="0 0 1" />
            <xacro:if value="${mirror_mesh == True}">
                <limit effort="${thumb_abad_torque_max}" velocity="${thumb_abad_velocity_max}"
                    lower="${thumb_abad_position_max*mirror}"
                    upper="${thumb_abad_position_min*mirror}" />
            </xacro:if>
            <xacro:if value="${mirror_mesh == False}">
                <limit effort="${thumb_abad_torque_max}" velocity="${thumb_abad_velocity_max}"
                    lower="${thumb_abad_position_min}" upper="${thumb_abad_position_max}" />
            </xacro:if>
        </joint>
        <link name="${name}_thumb_abad_link">
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${thumb_abad_com_x} ${thumb_abad_com_y*mirror} ${thumb_abad_com_z}" />
                <mass value="${thumb_abad_mass}" />
                <inertia
                    ixx="${thumb_abad_ixx}" ixy="${thumb_abad_ixy*mirror}"
                    ixz="${thumb_abad_ixz}"
                    iyy="${thumb_abad_iyy}" iyz="${thumb_abad_iyz*mirror}" izz="${thumb_abad_izz}" />
            </inertial>
            <visual>
                <xacro:if value="${mirror_mesh == True}">
                    <origin rpy="0 0 3.14" xyz="0 0 0" />
                </xacro:if>
                <xacro:if value="${mirror_mesh == False}">
                    <origin rpy="0 0 0" xyz="0 0 0" />
                </xacro:if>
                <geometry>
                    <mesh filename="${mesh_path}/thumb_abad.STL" />
                </geometry>
                <material name="blue" />
            </visual>
            <xacro:if value="${collision_type == 'fine'}">
                <collision name="${name}_thumb_abad_link_convex_0">
                    <xacro:if value="${mirror_mesh == True}">
                        <origin rpy="0 0 3.14" xyz="0 0 0" />
                    </xacro:if>
                    <xacro:if value="${mirror_mesh == False}">
                        <origin rpy="0 0 0" xyz="0 0 0" />
                    </xacro:if>
                    <geometry>
                        <mesh filename="${mesh_path}/collision/thumb_abad_col.STL" />
                    </geometry>
                </collision>
                <collision_checking>
                    <convex name="${name}_thumb_abad_link_convex_0" />
                </collision_checking>
            </xacro:if>
        </link>

        <!-- thumb mcp -->
        <joint name="idx${start_id+2}_${name}_thumb_mcp_joint" type="revolute">
            <origin xyz="${thumb_mcp_x} ${thumb_mcp_y*mirror} ${thumb_mcp_z}" rpy="0 0 0" />
            <parent link="${name}_thumb_abad_link" />
            <child link="${name}_thumb_mcp_link" />
            <axis xyz="1 0 0" />
            <xacro:if value="${mirror_mesh == True}">
                <limit effort="${thumb_mcp_torque_max}" velocity="${thumb_mcp_velocity_max}"
                    lower="${thumb_mcp_position_max*mirror}"
                    upper="${thumb_mcp_position_min*mirror}" />
            </xacro:if>
            <xacro:if value="${mirror_mesh == False}">
                <limit effort="${thumb_mcp_torque_max}" velocity="${thumb_mcp_velocity_max}"
                    lower="${thumb_mcp_position_min}" upper="${thumb_mcp_position_max}" />
            </xacro:if>
        </joint>
        <link name="${name}_thumb_mcp_link">
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${thumb_mcp_com_x} ${thumb_mcp_com_y*mirror} ${thumb_mcp_com_z}" />
                <mass value="${thumb_mcp_mass}" />
                <inertia
                    ixx="${thumb_mcp_ixx}" ixy="${thumb_mcp_ixy*mirror}" ixz="${thumb_mcp_ixz}"
                    iyy="${thumb_mcp_iyy}" iyz="${thumb_mcp_iyz*mirror}" izz="${thumb_mcp_izz}" />
            </inertial>
            <visual>
                <xacro:if value="${mirror_mesh == True}">
                    <origin rpy="0 0 3.14" xyz="0 0 0" />
                </xacro:if>
                <xacro:if value="${mirror_mesh == False}">
                    <origin rpy="0 0 0" xyz="0 0 0" />
                </xacro:if>
                <geometry>
                    <mesh filename="${mesh_path}/thumb_mcp.STL" />
                </geometry>
                <material name="brown" />
            </visual>
            <xacro:if value="${collision_type == 'coarse'}">
                <collision>
                    <origin rpy="0 0 0"
                        xyz="0 ${thumb_mcp_collision_box_y*mirror} ${thumb_mcp_collision_box_z}" />
                    <geometry>
                        <box
                            size="${thumb_mcp_collision_box_l} ${thumb_mcp_collision_box_w} ${thumb_mcp_collision_box_h}" />
                    </geometry>
                </collision>
            </xacro:if>
            <xacro:if value="${collision_type == 'fine'}">
                <collision name="${name}_thumb_mcp_link_convex_0">
                    <xacro:if value="${mirror_mesh == True}">
                        <origin rpy="0 0 3.14" xyz="0 0 0" />
                    </xacro:if>
                    <xacro:if value="${mirror_mesh == False}">
                        <origin rpy="0 0 0" xyz="0 0 0" />
                    </xacro:if>
                    <geometry>
                        <mesh filename="${mesh_path}/collision/thumb_mcp_col.STL" />
                    </geometry>
                </collision>
                <collision_checking>
                    <convex name="${name}_thumb_mcp_link_convex_0" />
                </collision_checking>
            </xacro:if>
        </link>

        <!-- thumb pip -->
        <joint name="idx${start_id+3}_${name}_thumb_pip_joint" type="revolute">
            <origin xyz="${thumb_pip_x} ${thumb_pip_y*mirror} ${thumb_pip_z}" rpy="0 0 0" />
            <parent link="${name}_thumb_mcp_link" />
            <child link="${name}_thumb_pip_link" />
            <axis xyz="1 0 0" />
            <xacro:if value="${mirror_mesh == True}">
                <limit effort="${thumb_pip_torque_max}" velocity="${thumb_pip_velocity_max}"
                    lower="${thumb_pip_position_max*mirror}"
                    upper="${thumb_pip_position_min*mirror}" />
            </xacro:if>
            <xacro:if value="${mirror_mesh == False}">
                <limit effort="${thumb_pip_torque_max}" velocity="${thumb_pip_velocity_max}"
                    lower="${thumb_pip_position_min}" upper="${thumb_pip_position_max}" />
            </xacro:if>
            <mimic
                joint="idx${start_id+2}_${name}_thumb_mcp_joint"
                multiplier="${thumb_pip_multiplier}"
                offset="0" />
        </joint>
        <link name="${name}_thumb_pip_link">
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${thumb_pip_com_x} ${thumb_pip_com_y*mirror} ${thumb_pip_com_z}" />
                <mass value="${thumb_pip_mass}" />
                <inertia
                    ixx="${thumb_pip_ixx}" ixy="${thumb_pip_ixy*mirror}" ixz="${thumb_pip_ixz}"
                    iyy="${thumb_pip_iyy}" iyz="${thumb_pip_iyz*mirror}" izz="${thumb_pip_izz}" />
            </inertial>
            <visual>
                <xacro:if value="${mirror_mesh == True}">
                    <origin rpy="0 0 3.14" xyz="0 0 0" />
                </xacro:if>
                <xacro:if value="${mirror_mesh == False}">
                    <origin rpy="0 0 0" xyz="0 0 0" />
                </xacro:if>
                <geometry>
                    <mesh filename="${mesh_path}/thumb_pip.STL" />
                </geometry>
                <material name="white" />
            </visual>
            <xacro:if value="${collision_type == 'coarse'}">
                <collision>
                    <origin rpy="${thumb_pip_collision_box_rotr*mirror} 0 0"
                        xyz="0 ${thumb_pip_collision_box_y*mirror} ${thumb_pip_collision_box_z}" />
                    <geometry>
                        <box
                            size="${thumb_pip_collision_box_l} ${thumb_pip_collision_box_w} ${thumb_pip_collision_box_h}" />
                    </geometry>
                </collision>
            </xacro:if>
            <xacro:if value="${collision_type == 'fine'}">
                <collision name="${name}_thumb_pip_link_convex_0">
                    <xacro:if value="${mirror_mesh == True}">
                        <origin rpy="0 0 3.14" xyz="0 0 0" />
                    </xacro:if>
                    <xacro:if value="${mirror_mesh == False}">
                        <origin rpy="0 0 0" xyz="0 0 0" />
                    </xacro:if>
                    <geometry>
                        <mesh filename="${mesh_path}/collision/thumb_pip_col.STL" />
                    </geometry>
                </collision>
                <collision_checking>
                    <convex name="${name}_thumb_pip_link_convex_0" />
                </collision_checking>
            </xacro:if>
        </link>

        <!-- thumb dip -->
        <joint name="idx${start_id+4}_${name}_thumb_dip_joint" type="revolute">
            <origin xyz="${thumb_dip_x} ${thumb_dip_y*mirror} ${thumb_dip_z}" rpy="0 0 0" />
            <parent link="${name}_thumb_pip_link" />
            <child link="${name}_thumb_dip_link" />
            <axis xyz="1 0 0" />
            <xacro:if value="${mirror_mesh == True}">
                <limit effort="${thumb_dip_torque_max}" velocity="${thumb_dip_velocity_max}"
                    lower="${thumb_dip_position_max*mirror}"
                    upper="${thumb_dip_position_min*mirror}" />
            </xacro:if>
            <xacro:if value="${mirror_mesh == False}">
                <limit effort="${thumb_dip_torque_max}" velocity="${thumb_dip_velocity_max}"
                    lower="${thumb_dip_position_min}" upper="${thumb_dip_position_max}" />
            </xacro:if>
            <mimic
                joint="idx${start_id+2}_${name}_thumb_mcp_joint"
                multiplier="${thumb_dip_multiplier}"
                offset="0" />
        </joint>
        <link name="${name}_thumb_dip_link">
            <inertial>
                <origin rpy="0 0 0"
                    xyz="${thumb_dip_com_x} ${thumb_dip_com_y*mirror} ${thumb_dip_com_z}" />
                <mass value="${thumb_dip_mass}" />
                <inertia
                    ixx="${thumb_dip_ixx}" ixy="${thumb_dip_ixy*mirror}" ixz="${thumb_dip_ixz}"
                    iyy="${thumb_dip_iyy}" iyz="${thumb_dip_iyz*mirror}" izz="${thumb_dip_izz}" />
            </inertial>
            <visual>
                <xacro:if value="${mirror_mesh == True}">
                    <origin rpy="0 0 3.14" xyz="0 0 0" />
                </xacro:if>
                <xacro:if value="${mirror_mesh == False}">
                    <origin rpy="0 0 0" xyz="0 0 0" />
                </xacro:if>
                <geometry>
                    <mesh filename="${mesh_path}/thumb_dip.STL" />
                </geometry>
                <material name="white" />
            </visual>
            <xacro:if value="${collision_type == 'coarse'}">
                <collision>
                    <origin rpy="${thumb_dip_collision_cylinder_rotr*mirror} 0 0"
                        xyz="0 ${thumb_dip_collision_cylinder_y*mirror} ${thumb_dip_collision_cylinder_z}" />
                    <geometry>
                        <cylinder radius="${thumb_dip_collision_cylinder_r}"
                            length="${thumb_dip_collision_cylinder_l}" />
                    </geometry>
                </collision>
            </xacro:if>
            <xacro:if value="${collision_type == 'fine'}">
                <collision name="${name}_thumb_dip_link_convex_0">
                    <xacro:if value="${mirror_mesh == True}">
                        <origin rpy="0 0 3.14" xyz="0 0 0" />
                    </xacro:if>
                    <xacro:if value="${mirror_mesh == False}">
                        <origin rpy="0 0 0" xyz="0 0 0" />
                    </xacro:if>
                    <geometry>
                        <mesh filename="${mesh_path}/collision/thumb_dip_col.STL" />
                    </geometry>
                </collision>
                <collision_checking>
                    <convex name="${name}_thumb_dip_link_convex_0" />
                </collision_checking>
            </xacro:if>
        </link>

        <joint name="${name}_thumb_tip_joint" type="fixed">
            <origin xyz="0 ${thumb_tip_y*mirror} ${thumb_tip_z}" rpy="0 0 0" />
            <parent link="${name}_thumb_dip_link" />
            <child link="${name}_thumb_tip" />
        </joint>
        <link name="${name}_thumb_tip">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0" />
                <geometry>
                    <sphere radius="1e-3" />
                </geometry>
                <material name="white" />
            </visual>
        </link>

    </xacro:macro>
</robot>
