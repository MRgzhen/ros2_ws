<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- main xacro -->
  <xacro:macro name="body" params="arm_base_link visual_type collision_type mesh_dir app">
    <!-- Body Link 1 -->
    <link name="body_link1">
      <inertial>
        <origin
          xyz="-0.10233943 -0.00512826 0.13584700"
          rpy="0 0 0" />
        <mass
          value="4.8629" />
        <inertia
          ixx="0.09165868"
          ixy="0.00000941"
          ixz="0.03477237"
          iyy="0.09033210"
          iyz="-0.00001870"
          izz="0.07168988" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <xacro:if value="${visual_type == 'stl'}">
          <geometry>
            <mesh
              filename="${mesh_dir}/G2L/LG/body_link1.STL" />
          </geometry>
          <material name="default" />
        </xacro:if>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision>
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/G2L/LG/body_link1.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'fine'}">
        <collision name="body_link1_fine_0">
          <origin xyz="-0.102309 -0.000000 0.135768" rpy="3.141593 0.643895 3.141592" />
          <geometry>
            <box size="0.155638 0.221417 0.494999" />
          </geometry>
        </collision>
      </xacro:if>
    </link>
    <joint
      name="idx01_body_joint1"
      type="revolute">
      <origin
        xyz="0.11 0 0.183"
        rpy="0 0 0" />
      <parent
        link="base_link" />
      <child
        link="body_link1" />
      <axis
        xyz="0 1 0" />
      <limit
        lower="-0.6459"
        upper="0.6459"
        effort="50"
        velocity="1.21" />
    </joint>

    <!-- Body Link 2 -->
    <link name="body_link2">
      <inertial>
        <origin
          xyz="0.08789329 -0.00425200 0.12549301"
          rpy="0 0 0" />
        <mass
          value="14.5259503" />
        <inertia
          ixx="0.26062068"
          ixy="0.00317164"
          ixz="-0.15205418"
          iyy="0.36658151"
          iyz="0.00458215"
          izz="0.15051963" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <xacro:if value="${visual_type == 'stl'}">
          <geometry>
            <mesh
              filename="${mesh_dir}/G2L/LG/body_link2.STL" />
          </geometry>
          <material name="default" />
        </xacro:if>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision>
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/G2L/LG/body_link2.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'fine'}">
        <collision name="body_link2_fine_0">
          <origin xyz="0.101598 -0.001500 0.139088" rpy="2.552626 0.000000 -1.570796" />
          <geometry>
            <box size="0.175000 0.193185 0.499157" />
          </geometry>
        </collision>
      </xacro:if>
    </link>
    <joint
      name="idx02_body_joint2"
      type="revolute">
      <origin
        xyz="-0.20462 0 0.27154"
        rpy="0 0 0" />
      <parent
        link="body_link1" />
      <child
        link="body_link2" />
      <axis
        xyz="0 1 0" />
      <limit
        lower="-1.2568"
        upper="1.2568"
        effort="50"
        velocity="1.21" />
    </joint>

    <!-- Body Link 3 -->
    <link name="body_link3">
      <inertial>
        <origin
          xyz="0.00028825 0.00577234 0.05050757"
          rpy="0 0 0" />
        <mass
          value="1.5063" />
        <inertia
          ixx="0.01172047"
          ixy="0.00000256"
          ixz="-0.00002841"
          iyy="0.00756075"
          iyz="0.00061894"
          izz="0.00871524" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <xacro:if value="${visual_type == 'stl'}">
          <geometry>
            <mesh
              filename="${mesh_dir}/G2L/LG/body_link3.STL" />
          </geometry>
          <material name="default" />
        </xacro:if>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision>
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/G2L/LG/body_link3.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'fine'}">
        <collision name="body_link3_fine_0">
          <origin xyz="0.001486 0.001247 0.022770" rpy="-0.051786 0.068387 0.051786"/>
          <geometry>
            <cylinder radius="0.110071" length="0.049634"/>
          </geometry>
        </collision>
        <collision name="body_link3_fine_1">
          <origin xyz="-0.000138 -0.000124 -0.001956" rpy="0.000000 -0.000000 0.000000"/>
          <geometry>
            <sphere radius="0.110071"/>
          </geometry>
        </collision>
        <collision name="body_link3_fine_2">
          <origin xyz="0.003111 0.002617 0.047495" rpy="0.000000 -0.000000 0.000000"/>
          <geometry>
            <sphere radius="0.110071"/>
          </geometry>
        </collision>
        <collision_checking>
          <capsule name="body_link3_fine_0" />
          <capsule name="body_link3_fine_1" />
          <capsule name="body_link3_fine_2" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint
      name="idx03_body_joint3"
      type="revolute">
      <origin
        xyz="0.18641 0 0.26622"
        rpy="0 0 0" />
      <parent
        link="body_link2" />
      <child
        link="body_link3" />
      <axis
        xyz="0 1 0" />
      <limit
        lower="-0.611"
        upper="1.7804"
        effort="50"
        velocity="1.21" />
    </joint>

    <!-- Body Link 4 -->
    <link name="body_link4">
      <inertial>
        <origin
          xyz="-0.01292162 -0.00019616 0.11608630"
          rpy="0 0 0" />
        <mass
          value="12.8858638" />
        <inertia
          ixx="0.11276222"
          ixy="-0.00004926"
          ixz="0.00341114"
          iyy="0.13658002"
          iyz="0.00004213"
          izz="0.08185590" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <xacro:if value="${visual_type == 'stl'}">
          <geometry>
            <mesh
              filename="${mesh_dir}/G2L/LG/body_link4.STL" />
          </geometry>
          <material name="default" />
        </xacro:if>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision>
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/G2L/LG/body_link4.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'fine'}">
        <collision name="body_link4_fine_0">
          <origin xyz="-0.007644 -0.000420 0.114960" rpy="-3.136359 0.052107 3.136359" />
          <geometry>
            <cylinder radius="0.156228" length="0.147748" />
          </geometry>
        </collision>
        <collision name="body_link4_fine_1">
          <origin xyz="-0.011490 -0.000014 0.188733" rpy="0.000000 -0.000000 0.000000" />
          <geometry>
            <sphere radius="0.156228" />
          </geometry>
        </collision>
        <collision name="body_link4_fine_2">
          <origin xyz="-0.003799 -0.000827 0.041187" rpy="0.000000 -0.000000 0.000000" />
          <geometry>
            <sphere radius="0.156228" />
          </geometry>
        </collision>
        <collision_checking>
          <capsule name="body_link4_fine_0" />
          <capsule name="body_link4_fine_1" />
          <capsule name="body_link4_fine_2" />
        </collision_checking>
      </xacro:if>
    </link>
    <joint
      name="idx04_body_joint4"
      type="revolute">
      <origin
        xyz="0 0 0.12"
        rpy="0 0 0" />
      <parent
        link="body_link3" />
      <child
        link="body_link4" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-2.7403"
        upper="2.7403"
        effort="50"
        velocity="1.21" />
    </joint>

    <!-- Head Link 1 -->
    <link name="head_link1">
      <inertial>
        <origin
          xyz="-0.00042749 -0.00890968 0.09576198"
          rpy="0 0 0" />
        <mass
          value="0.56486602" />
        <inertia
          ixx="0.00082179"
          ixy="-0.00000063"
          ixz="0.00000305"
          iyy="0.00075638"
          iyz="0.00009608"
          izz="0.00028684" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <xacro:if value="${visual_type == 'stl'}">
          <geometry>
            <mesh
              filename="${mesh_dir}/G2L/LG/head_link1.STL" />
          </geometry>
          <material name="default" />
        </xacro:if>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision>
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/G2L/LG/head_link1.STL" />
          </geometry>
        </collision>
      </xacro:if>
    </link>
    <joint
      name="idx11_head_joint1"
      type="revolute">
      <origin
        xyz="-0.0168 0 0.239"
        rpy="0 0 0" />
      <parent
        link="body_link4" />
      <child
        link="head_link1" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-1.5708"
        upper="1.5708"
        effort="50"
        velocity="2.5" />
    </joint>

    <!-- Head Link 2 -->
    <link name="head_link2">
      <inertial>
        <origin
          xyz="0.04373228 -0.00375212 0.02823564"
          rpy="0 0 0" />
        <mass
          value="2.7231" />
        <inertia
          ixx="0.01360107"
          ixy="0.00006573"
          ixz=" -0.00017051"
          iyy="0.00937096"
          iyz="0.00022757"
          izz="0.01765490" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <xacro:if value="${visual_type == 'stl'}">
          <geometry>
            <mesh
              filename="${mesh_dir}/G2L/LG/head_link2.STL" />
          </geometry>
          <material name="default" />
        </xacro:if>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision>
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/G2L/LG/head_link2.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'fine'}">
        <collision name="head_link2_fine_0">
          <origin xyz="0.030290 -0.000534 0.027163" rpy="0.576090 1.566457 2.158425" />
          <geometry>
            <box size="0.143381 0.233745 0.234737" />
          </geometry>
        </collision>
      </xacro:if>
    </link>
    <joint
      name="idx12_head_joint2"
      type="revolute">
      <origin
        xyz="0 0 0.1165"
        rpy="0 0 0" />
      <parent
        link="head_link1" />
      <child
        link="head_link2" />
      <axis
        xyz="0 1 0" />
      <limit
        lower="-0.1399"
        upper="0.1399"
        effort="50"
        velocity="2.5" />
    </joint>

    <!-- Arm Base Link -->
    <joint name="idx20_arm_base_joint" type="fixed">
      <parent link="body_link4" />
      <child link="${arm_base_link}" />
      <origin xyz="0.0 0.0 0.205" rpy="-1.5708 0 0" />
      <axis xyz="0 0 1" />
    </joint>
    <link name="${arm_base_link}">
      <inertial>
        <origin xyz="-0.00002 -0.00012 0.16134" rpy="0 0 0" />
        <mass value="2.89" />
        <inertia ixx="0.01932018" ixy="-0.00000029" ixz="-0.00000083" iyy="0.02037062"
          iyz="0.00005022" izz="0.00398997" />
      </inertial>
    </link>

  </xacro:macro>
</robot>
