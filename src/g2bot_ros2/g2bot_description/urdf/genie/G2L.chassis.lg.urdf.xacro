        </collision>
      </xacro:if>
    </link>
    <joint
      name="idx111_chassis_lwheel_front_joint1"
      type="revolute">
      <origin
        xyz="0.21 0.18 0.11201"
        rpy="0 0 0" />
      <parent
        link="base_link" />
      <child
        link="chassis_lwheel_front_link1" />
      <axis
        xyz="0 0 1" />
      <limit
        lower="-2.9321531433504737"
        upper="2.9321531433504737"
        effort="15"
        velocity="4" />
    </joint>
    <link name="chassis_lwheel_front_link2">
