<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- main xacro -->
  <xacro:macro name="chassis" params="visual_type collision_type mesh_dir app">

    <!-- Base Link -->
    <link name="base_link">
      <inertial>
        <origin
          xyz="-0.02869382 -0.00023613 0.10777243"
          rpy="0 0 0" />
        <mass
          value="64.45" />
        <inertia
          ixx="1.64403328"
          ixy="-0.00932675"
          ixz="-0.11289969"
          iyy="2.25783468"
          iyz="0.00080416"
          izz="3.24918977" />
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <xacro:if value="${visual_type == 'stl'}">
          <geometry>
            <mesh
              filename="${mesh_dir}/G2L/LG/base_link.STL" />
          </geometry>
          <material name="default" />
        </xacro:if>
      </visual>
      <xacro:if value="${collision_type == 'visual'}">
        <collision>
          <origin
            xyz="0 0 0"
            rpy="0 0 0" />
          <geometry>
            <mesh
              filename="${mesh_dir}/G2L/LG/base_link.STL" />
          </geometry>
        </collision>
      </xacro:if>
      <xacro:if value="${collision_type == 'fine'}">
        <collision name="base_link_fine_0">
          <origin xyz="0 0 0" rpy="0 0 0" />
          <geometry>
            <mesh filename="${mesh_dir}/G2L/LG/convex/base_link_0.STL" />
          </geometry>
        </collision>
        <collision_checking>
          <convex name="base_link_fine_0" />
        </collision_checking>
      </xacro:if>
    </link>

    <!-- Chassis Left Wheel Front -->
    <link name="chassis_lwheel_front_link1">
      <inertial>
        <origin
          xyz="7.3647E-05 -0.024821 -0.039792"
          rpy="0 0 0" />
        <mass
          value="0.40442" />
        <inertia
          ixx="0.00063656"
          ixy="-0.00000073"
